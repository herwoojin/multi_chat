rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 방 멤버인지 Firestore 의 rooms/{roomId}.memberUids 로 판정한다 (교차 서비스 규칙).
    // 익명 로그인은 누구나 할 수 있으므로 "로그인했는가"만으로는 아무나 업로드할 수 있게 된다.
    function isMember(roomId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.memberUids;
    }

    match /rooms/{roomId}/{fileName} {
      allow read: if isMember(roomId);

      allow create: if isMember(roomId)
        && resource == null                                  // 같은 경로에 이미 파일이 있으면 거부
        && request.resource.size < 5 * 1024 * 1024          // 5MB
        && request.resource.contentType.matches('image/.*');

      allow update, delete: if false;                        // 올린 사진은 덮어쓰거나 지울 수 없다
    }
  }
}
