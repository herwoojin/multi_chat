# ─── 로컬 에뮬레이터 모드 (npm run dev:local 이 vite --mode emulator 로 읽는다) ───
# 비밀값 없음. demo- 로 시작하는 프로젝트 ID 는 실제 클라우드 리소스에 절대 닿지 않는다.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-maltong

# joinRoom Function(Admin SDK)용 — firebase emulators:exec 가 같은 값을 넣어 주지만, 따로 띄울 때를 위해 둔다
GCLOUD_PROJECT=demo-maltong
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
